# Variables de entorno (ejemplo). Copie a .env real FUERA del repositorio y rellene. Nunca suba valores reales.

# ── Base de datos ──
# Usuario de la aplicación con permisos mínimos (ver deploy/sql/crear-usuario-aplicacion.sql). NO use 'sa'.
API_CONNECTION_STRING=Server=sql;Database=MedicalHub;User Id=medicalhub_app;Password=<definir-en-gestor-de-secretos>;Encrypt=True;TrustServerCertificate=True
SQL_SA_PASSWORD=<contraseña-larga-solo-para-administrar-el-servidor>

# ── Seguridad ──
# Clave HMAC del JWT: 32 bytes o más, aleatoria (p. ej. `openssl rand -base64 48`).
JWT_KEY=<definir-en-gestor-de-secretos>
# Origen público de la web (CORS)
PUBLIC_URL=https://app.ejemplo.es

# ── Primer administrador de plataforma (solo la primera vez; vacíe estas variables después) ──
BOOTSTRAP_EMAIL=
BOOTSTRAP_NOMBRE=
BOOTSTRAP_PASSWORD=

# ── Opcional ──
WEB_PORT=8080
# Plazos de retención en días (0 desactiva ese tipo de depuración). Añádalos como Retencion__<Nombre> al servicio api:
#   Retencion__NotificacionesLeidasDias=90  Retencion__NotificacionesDias=365  Retencion__EventosSeguridadDias=365
#   Retencion__TokensRefrescoDias=30        Retencion__AuditoriaDias=1825
#   Retencion__UbicacionesFichajeDias=90   (anonimiza las coordenadas de los fichajes y conserva las horas)
